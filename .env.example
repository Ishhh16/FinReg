# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Optional Server Settings
DEBUG=False
APP_NAME=FinReg API
VERSION=3.0.0

# Comma-separated list of Gemini API keys for automatic failover/rotation (Optional)
# If empty, the system will fall back to using GEMINI_API_KEY
GEMINI_API_KEYS=your_first_gemini_key,your_second_gemini_key

# Single Gemini API Key (Fallback option)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration
# Base API URL matching the FastAPI backend listener (default: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000
