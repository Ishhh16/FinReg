# Virtual Environments
venv/
.venv/
ENV/
env/

# Python Cache & Compiled Files
**/__pycache__/
*.py[cod]
*$py.class
*.pyc
*.so

# Frontend Build & Node Modules
node_modules/
dist/
build/
dist-ssr/
*.local

# Environment Configuration Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database & ChromaDB Generated Store
chroma_db/
*.db
*.sqlite3

# Reports Cache & PDFs
reports/*
!reports/.gitkeep
*.pdf

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pip-log.txt

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Allow regulatory PDF documents to be tracked
!regulations/*.pdf

